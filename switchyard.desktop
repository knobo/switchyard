[Desktop Entry]
Version=1.0
Name=Switchyard
GenericName=URL Dispatcher
Comment=URL dispatcher - routes URLs to the right browser and profile
Exec=switchyard %u
Terminal=false
Type=Application
Categories=Network;WebBrowser;
MimeType=x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/claude;x-scheme-handler/about;x-scheme-handler/unknown;text/html;
Icon=web-browser
StartupNotify=false
